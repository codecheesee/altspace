{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "altspace",
  "version": "2.1.0",
  "identifier": "com.altspace.launcher",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AltSpace",
        "width": 800,
        "height": 520,
        "resizable": false,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "alwaysOnTop": true,
        "center": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://open.er-api.com http://localhost:11434 http://127.0.0.1:11434 https://api.github.com https://raw.githubusercontent.com https://discord.com https://api.anthropic.com https://api.openai.com https://api.deepseek.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "resources": {
      "../../bin/Everything64.dll": "Everything64.dll"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "AltSpace",
        "displayLanguageSelector": false
      }
    }
  }
}